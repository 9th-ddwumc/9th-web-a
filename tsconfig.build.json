{
  "extends": "./tsconfig.json",
  "exclude": ["node_modules", "test", "dist", "**/*spec.ts", "client", "client/**"],
  "include": ["src/**/*.ts"],             // ⬅️ 백엔드 .ts만 포함
  "exclude": [
    "node_modules",
    "dist",
    "client", "client/**",                // ⬅️ 프론트 전체 제외
    "**/*.tsx", "**/*.jsx"                // ⬅️ 혹시 남아도 TSX/JX는 제외
  ]
}
